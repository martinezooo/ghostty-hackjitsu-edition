// Hack-Jitsu: self-contained Zellij defaults, never changes ~/.config/zellij.
// Using an explicit config prevents the interactive first-run keybinding wizard.
// No hard-coded session_name here. Isolated Zsh chooses a unique readable
// username-based name (username-2 if occupied) for each NEW session.
// Ghostty's title setting does not change the Zellij session label.
default_mode "normal"
show_release_notes false
simplified_ui true
// Keep Zellij mouse wheel and trackpad scrolling. Disabling mouse mode
// breaks normal scrollback behavior inside panes.
mouse_mode true
// On Zellij 0.45.1+, scrolling must not automatically change to SCROLL mode.
scroll_mode_sync false
// Copy selected text directly to the macOS clipboard instead of OSC 52.
copy_command "pbcopy"
// With mouse capture enabled, Zellij owns drag-selection; copy on release.
// Hold Shift when dragging to select in Ghostty instead.
copy_on_select true
// Start with a normal shell pane, not Zellij's first-run/about screen.
show_startup_tips false
default_layout "default"
default_shell "/bin/zsh"
// New Hack-Jitsu sessions must not resurrect editor panes after a terminal
// restart. This affects only sessions launched with this private config.
session_serialization false
// When Ghostty is fully closed, stop this temporary session instead of
// detaching and accumulating abandoned sessions in the background.
// Merely hiding the dropdown does not close the terminal or its Zellij pane.
on_force_close "quit"
